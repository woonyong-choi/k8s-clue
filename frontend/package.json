{
  "name": "clue-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2 --testTimeout=120000",
    "lint": "eslint src --max-warnings 0",
    "check:bundle": "npm run build && node scripts/check-initial-bundle.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:bundle",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.63.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}

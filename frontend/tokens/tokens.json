{
  "$description": "사건 이력 화면(incident-history.css)이 쓰는 값의 정본. 기존 전역 스타일의 값은 옮기지 않았다. 간격은 4px 기본 단위의 배수다.",
  "font": {
    "$type": "fontFamily",
    "mono": { "$value": ["IBM Plex Mono", "monospace"], "$description": "styles.css가 불러오는 기존 모노 글꼴" }
  },
  "size": {
    "text": {
      "$type": "dimension",
      "12": { "$value": "0.75rem" },
      "13": { "$value": "0.8125rem" },
      "14": { "$value": "0.875rem" }
    },
    "column": {
      "$type": "dimension",
      "time": { "$value": "220px", "$description": "이력 이벤트의 시각 열. UTC ISO 문자열이 한 줄에 들어가는 폭" }
    }
  },
  "leading": {
    "$type": "number",
    "normal": { "$value": 1.6 },
    "relaxed": { "$value": 1.7 }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" }
  },
  "border": {
    "$type": "dimension",
    "thin": { "$value": "1px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "900px", "$description": "styles.css의 기존 900px 경계와 같다" }
  }
}
